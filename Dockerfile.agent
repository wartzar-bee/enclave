# Enclave agent runtime — lean, self-contained, no extra baked content.
#
#   docker build -f Dockerfile.agent -t enclave-agent:latest .
#
# Per-agent run: mount the agent's home dir -> /agent, its scoped secrets -> /workspace/.secrets.
# The agent reaches optional host tools (qmd / gcloud bridge) via host.docker.internal.
FROM ubuntu:24.04
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
      python3 python3-pip nodejs npm git curl ca-certificates \
    && rm -rf /var/lib/apt/lists/*
# Minimal python deps the runtime uses (no content-creation libs).
RUN pip3 install --no-cache-dir --break-system-packages pyyaml requests
# Pinned Claude CLI (BRAIN=claude). Fail loud — a missing CLI = a dead agent.
RUN npm i -g @anthropic-ai/claude-code@2.1.170
ENV PATH=/usr/local/bin:$PATH

# Security-first default: opt OUT of CLI telemetry for any tool that honors it (codegraph et al.).
ENV DO_NOT_TRACK=1

# Optional CODE-MEMORY accelerator (opt-in — OFF by default to keep the base image lean):
#   docker compose build --build-arg INSTALL_CODEGRAPH=1 agent   (or set INSTALL_CODEGRAPH=1 in .env)
# Pulls the linux bundle (its own node + tree-sitter grammars). Vetted: docs/VETTING.md
# (@colbymchenry/codegraph@1.0.1 — no install scripts; telemetry is counts-only AND baked OFF above).
# It's a STDIO MCP server (`codegraph serve --mcp`) the agent spawns, so it must live in THIS image
# (not a network sidecar like qmd). See docs/CODE-MEMORY.md.
ARG INSTALL_CODEGRAPH=0
RUN if [ "$INSTALL_CODEGRAPH" = "1" ]; then npm i -g @colbymchenry/codegraph@1.0.1; fi

# Optional NOOA worker harness (opt-in — OFF by default; the base image stays stdlib-only):
#   docker compose build --build-arg INSTALL_NOOA=1 agent
# NVIDIA's object-oriented agent harness (Apache-2.0), used by nooa_worker.py as an alternative
# worker brain for code-over-data tasks. Vetted 2026-08-17 (ENCLAVE-NOOA-EVAL doc): official
# NVIDIA-NeMo org, no phone-home (OTLP export requires a localhost viewer or explicit
# OTLP_ENDPOINT), no install hooks, secret-scrubbing defensive; pip-audit clean at these pins.
# litellm pinned at its CVE-2026-49468-fix floor (also past the yanked/backdoored 1.82.7/8).
# NOOA executes model-written Python IN-PROCESS — the pod container IS the containment boundary
# (same doctrine as the agent's own bash tool). Routing doctrine: nooa_worker.py refuses any
# claude/anthropic model id — Claude tokens come ONLY from the claude CLI pool.
ARG INSTALL_NOOA=0
RUN if [ "$INSTALL_NOOA" = "1" ]; then \
      pip3 install --no-cache-dir --break-system-packages nooa==0.0.8 litellm==1.84.0; fi

# Bake ONLY the Enclave runtime (the layout the scripts assume: W=/workspace). No venture content.
COPY platform/agentd/  /workspace/platform/agentd/
COPY tools/            /workspace/tools/

# Non-root (claude refuses --dangerously-skip-permissions as root).
# /workspace holds the RUNTIME that governs the agent: runtime.sh, the guard + hooks source that
# runtime.sh re-syncs from, contracts.py, policy.json. The agent runs as uid 1001 and must NOT be
# able to rewrite that code — a guard the agent can edit is not a boundary (it could neuter guard.py
# on one tick and act freely the next). Root-own the whole runtime (world-readable, so the agent can
# still READ + execute it), and carve out ONLY platform/agentd/state/, the one dir the agent writes
# at runtime (claude_usage cache; the writer already tolerates a read-only/absent dir). The scoped
# secrets and the agent HOME are separate mounts, unaffected.
RUN useradd -m -u 1001 -s /bin/bash agent \
    && chown -R root:root /workspace \
    && mkdir -p /workspace/platform/agentd/state && chown -R agent:agent /workspace/platform/agentd/state \
    && mkdir -p /home/agent/.claude && chown -R agent:agent /home/agent/.claude   # agent-owned so a persistent .claude volume is writable
WORKDIR /agent
USER agent
ENV HOME=/home/agent AGENT_DIR=/agent
# Reads /agent/agent.env for DEFAULTS (docker -e overrides win), then runs the event-driven loop
# (RUNTIME_MODE=daemon) or the fixed-interval loop (RUNTIME_MODE=tick).
CMD ["bash","-c","while IFS='=' read -r k v; do case \"$k\" in (''|\\#*) ;; (*) [ -z \"${!k+x}\" ] && export \"$k=$v\";; esac; done < \"${AGENT_DIR}/agent.env\"; case \"${RUNTIME_MODE:-daemon}\" in tick) while true; do bash /workspace/platform/agentd/runtime.sh ${AGENT_DIR}; sleep ${INTERVAL_SECONDS:-10800}; done ;; *) exec python3 /workspace/platform/agentd/agentloop.py ${AGENT_DIR} ;; esac"]
