# Secrets — NEVER commit. Credentials live here at runtime.
secrets/
.env

# Local handoff doc (not part of the product) — keep on disk, never commit.
RESUME.md

# Per-deployment agent home (generated by `enclave init`; the template lives in templates/).
# A clone ships an empty home/ (.gitkeep) and the teammate runs `enclave init` to fill it.
home/*
!home/.gitkeep
**/chat-reply.md
**/chat-history.jsonl

# Build / tooling
node_modules/
.codegraph/
__pycache__/
*.pyc
*.log
.DS_Store
platform/agentd/state/
RESUME-DELEGATION.md

# installed plugins are runtime state, not source (examples/plugins/ IS tracked)
/plugins/

# Deployment-local, scaffolded by `enclave init`/`new` into the checkout when it IS the deployment.
# egress-policy.json names the hosts a specific agent may reach — internal endpoints included; the
# override carries per-deployment mounts and sidecar wiring. Neither belongs in the public tree.
egress-policy.json
docker-compose.override.yml

# Operator-supplied private terms for tools/publish_audit.py. Naming the private things it
# protects, it must never be published — the scanner would become the leak.
.publish-audit-deny
